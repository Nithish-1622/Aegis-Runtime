{
  "info": {
    "_postman_id": "b0b8d9a5-9d1f-4f7e-8b45-0ce0f7b7ad61",
    "name": "Aegis Runtime - Trace Reconstruction and Analytics",
    "description": "Collection for Runtime Timeline, Execution Graph, and Analytics endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Runtime Timeline",
      "description": "Returns the ordered runtime timeline for a traceId using persisted RuntimeEvents.",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/runtime/timeline/{{traceId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "runtime",
            "timeline",
            "{{traceId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Execution Graph",
      "description": "Returns the semantic execution graph for a traceId including nodes, edges, and statistics.",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/runtime/graph/{{traceId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "runtime",
            "graph",
            "{{traceId}}"
          ]
        }
      },
      "response": [
        {
          "name": "Example Graph Response",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/runtime/graph/{{traceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "runtime",
                "graph",
                "{{traceId}}"
